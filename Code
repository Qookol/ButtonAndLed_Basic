
#define ledPin 2
#define button 4

int lastStateButton = HIGH;

void setup() {
  Serial.begin(115200);

  pinMode(ledPin, OUTPUT);
  pinMode(button, INPUT_PULLUP);

  digitalWrite(ledPin, LOW);
}

void loop() {
  int buttonState = digitalRead(button);

  if (buttonState != lastStateButton) {
    delay(30); // ลดปัญหาจากหน้าสัมผัสปุ่มเด้ง
    buttonState = digitalRead(button);

    if (buttonState != lastStateButton) {
      Serial.print("ปุ่มเปลี่ยนสถานะ: ");
      Serial.println(buttonState == LOW ? "กดอยู่ (LOW)" : "ปล่อยแล้ว (HIGH)");

      if (buttonState == LOW) {
        digitalWrite(ledPin, HIGH);
        delay(2000);
        digitalWrite(ledPin, LOW);
      }

      lastStateButton = buttonState;
    }
  }
}
