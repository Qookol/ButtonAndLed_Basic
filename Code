
#define ledPin 2
#define button 4

int lastStateButton = HIGH;
int ledState = LOW;

void setup() {
  Serial.begin(115200);

  pinMode(ledPin, OUTPUT);
  pinMode(button, INPUT_PULLUP);

  digitalWrite(ledPin, ledState);
}

void loop() {
  int buttonState = digitalRead(button);

  if (buttonState != lastStateButton) {
    delay(30);  // ลดปัญหาปุ่มเด้ง
    buttonState = digitalRead(button);

    if (buttonState != lastStateButton) {

      // ทำงานเฉพาะตอนกดปุ่ม
      if (buttonState == LOW) {
        ledState = !ledState;
        digitalWrite(ledPin, ledState);

        Serial.println(ledState == HIGH? "LED ON" : "LED OFF");
      }

      lastStateButton = buttonState;
    }
  }
}
